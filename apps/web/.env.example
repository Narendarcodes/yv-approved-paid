# Frontend env (build-time: Vite inlines VITE_* when you run `npm run build`).
# Copy to .env for local dev.

# Base URL of the REST API. Leave unset to use same-origin /api/v1
# (production behind a reverse proxy, and `npm run dev` via the Vite proxy).
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Dev-only: where the Vite dev server proxies /api, /socket.io and /uploads.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
