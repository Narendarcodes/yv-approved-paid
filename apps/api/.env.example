# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ---- MongoDB ----
# Local dev (docker compose up -d mongo) or any MongoDB URI
MONGO_URI=mongodb://127.0.0.1:27017/cop
# Optional: keep DB credentials out of the URI (they override user:pass in MONGO_URI)
# MONGO_USER=
# MONGO_PASSWORD=

# ---- JWT ----
# Access-token secret. CHANGE THIS in any real environment.
# Production: >= 32 chars and not a default, or the app refuses to start
# (all production checks: src/config/validate.js). e.g. openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are stored hashed (SHA-256) in the DB and expire after this many days
JWT_REFRESH_EXPIRES_DAYS=7

# ---- Cookie sessions + CSRF (docs/adr/0017) ----
# Browsers keep the session in httpOnly cookies; unsafe requests carry X-CSRF-Token.
# REQUIRED in production (>= 32 chars), e.g. openssl rand -hex 32
CSRF_SECRET=
# Secure cookies: default true in production (false is refused there), false in dev.
# COOKIE_SECURE=true
# strict (default) | lax | none (none requires Secure; only for a cross-site API)
# COOKIE_SAMESITE=strict
# Only when app and API are on different subdomains of one parent domain:
# COOKIE_DOMAIN=example.com

# ---- CORS ----
# Comma-separated list of allowed origins (scheme://host[:port], no path, no '*').
# REQUIRED in production: the API refuses to start without it. Credentials
# (cookies) are allowed only for these origins.
# Dev default when unset: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN=https://app.example.com

# ---- Reverse proxy ----
# Express 'trust proxy': 1 = one proxy hop (Caddy/nginx in front). Needed so
# rate limits see the real client IP. Leave unset when nothing is in front.
# TRUST_PROXY=1

# ---- Storage (file uploads) ----
# 'local' writes uploads to STORAGE_LOCAL_DIR. Swap in a cloud adapter later.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# ---- Rate limiting (global per-IP) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Social publishing (Postiz) ----
# Leave both empty to use the built-in local scheduler (demo channels,
# simulated publish + metrics). Set both to publish through a Postiz instance:
#   cloud:       POSTIZ_API_URL=https://api.postiz.com/public/v1
#   self-hosted: POSTIZ_API_URL=https://<your-postiz>/api/public/v1
POSTIZ_API_URL=
POSTIZ_API_KEY=
# Webhook secret (>= 32 chars; REQUIRED in production once POSTIZ_API_URL is set).
# Empty = the webhook rejects every call (503, fail closed); the reconcile loop
# still syncs post state by polling. Postiz sends no auth header, so register
# the webhook URL in Postiz as:
#   https://<api-host>/api/v1/webhooks/postiz/<POSTIZ_WEBHOOK_SECRET>
# (the token is redacted from logs). Also accepted: X-Webhook-Secret: <secret>,
# or X-Postiz-Signature: sha256=<hex HMAC-SHA256(secret, raw body)>.
POSTIZ_WEBHOOK_SECRET=
# How often due posts are published / Postiz state polled (ms). 0 disables.
SCHEDULER_INTERVAL_MS=15000

# ---- Private /internal API (agent + worker only) ----
# Separate listener, never the public PORT. Loopback by default; in docker
# compose it binds to the api's address on the private 'backend' network.
INTERNAL_PORT=3001
INTERNAL_HOST=127.0.0.1
# Shared token the agent/worker send in X-Internal-Token (plus the per-call
# service JWT). Required in production when the agent is enabled (>= 32 chars).
INTERNAL_API_TOKEN=

# ---- Live deal copilot (Node -> lean deal agent, services/agent/app/deals_service.py) ----
# Needs AGENT_ENABLED not 'false' (in production that also requires SERVICE_JWT_SECRET
# and INTERNAL_API_TOKEN above). Unset AGENT_SHARED_SECRET = copilot answers offline.
# AGENT_ENABLED=true
# AGENT_URL=https://yv-deals-agent.onrender.com
# Same value as AGENT_SHARED_SECRET on the agent; sent as X-Agent-Secret (>= 32 chars).
AGENT_SHARED_SECRET=
# Free instances cold-start slowly; past this the web falls back to the offline replay.
# AGENT_COPILOT_TIMEOUT_MS=15000

# ---- Brute-force limits on credential endpoints (Phase 1 item 9) ----
# Per IP and per account, fixed windows; over the limit -> 429 + Retry-After.
# Login's per-account limit counts FAILED attempts only. Counters are in-memory
# per API process (use a shared store, e.g. Redis, when running >1 instance).
AUTH_RATE_LIMIT_ENABLED=true
# AUTH_LOGIN_IP_MAX=30            AUTH_LOGIN_IP_WINDOW_MS=900000
# AUTH_LOGIN_ACCOUNT_MAX=10       AUTH_LOGIN_ACCOUNT_WINDOW_MS=900000
# AUTH_REGISTER_IP_MAX=10         AUTH_REGISTER_IP_WINDOW_MS=3600000
# AUTH_REGISTER_ACCOUNT_MAX=5     AUTH_REGISTER_ACCOUNT_WINDOW_MS=3600000
# AUTH_REFRESH_IP_MAX=120         AUTH_REFRESH_IP_WINDOW_MS=900000
# AUTH_REFRESH_ACCOUNT_MAX=60     AUTH_REFRESH_ACCOUNT_WINDOW_MS=900000
# AUTH_DEMO_IP_MAX=20             AUTH_DEMO_IP_WINDOW_MS=900000   (POST /auth/demo-login)
# Behind a reverse proxy set TRUST_PROXY (above) or every client shares the proxy IP.

# --- Approved = Paid (deals) ---
# PAYPAL_MODE=mock                 # mock | sandbox | live
# PAYPAL_CLIENT_ID=                # sandbox/live app credentials (developer.paypal.com > Apps & Credentials); never commit
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=               # optional: verifies PayPal webhooks (sandbox/live)
# Sandbox: holds (Orders v2 AUTHORIZE), authorization, capture, partial capture + void, reauthorize
# and INV2 invoices are REAL sandbox calls. Payouts are refused for an India sandbox merchant
# (PAYOUT_NOT_AVAILABLE) and recorded as SIM-PAYOUT. See docs/paypal-sandbox.md.
# PAYPAL_SANDBOX_POOL=0            # sandbox demo: don't draw real holds from the pre-approved authorization pool (default: on with DEMO_MODE=1); refill with scripts/paypal-auth-pool.cjs
# PAYPAL_SANDBOX_SIMULATE=1        # sandbox outside DEMO_MODE: use the pool, and the labelled SIM- fallback only when it is empty (DEMO_MODE=1 turns it on)
# DEMO_MODE=1                      # judge demo: seeds "Diwali launch reels" on boot (mock or sandbox), opens POST /auth/demo-login and POST /demo/deal/reset (one pool pair per reset)
# DEMO_JUDGE_PASSWORD=             # optional: also lets the judge sign in with a password
# DEALS_EVIDENCE_DIR=./uploads/deal-evidence   # check screenshots (shared with the agent's evidence_dir)
# CLOCK_SHARED_SECRET=            # Fair Review Clock driver: enables POST /api/v1/internal/clock/advance (header X-Clock-Secret); unset = 404. The Money Agent tick also advances clocks in-process.
