{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deal.schema.json",
  "title": "DealView",
  "description": "The deal as one party sees it (GET /organizations/:org/deals/:dealId). Amounts are minor units from the signed deal and the ledger, never from a model. Mirrors apps/api/src/modules/deals/lib/types.cts.",
  "type": "object",
  "required": [
    "id",
    "orgId",
    "terms",
    "signatures",
    "milestones",
    "pendingApprovals",
    "humanApprovals",
    "changeOrders",
    "termsHashNow"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "terms": {
      "$ref": "#/definitions/DealTerms"
    },
    "termsHash": {
      "type": "string"
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DealSignature"
      }
    },
    "lockedAt": {
      "type": "string"
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DealMilestoneRuntime"
      }
    },
    "executedKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pendingApprovals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DealPendingApproval"
      }
    },
    "lastBlocked": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "humanApprovals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DealAlert"
      }
    },
    "changeOrders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DealChangeOrder"
      }
    },
    "me": {
      "type": ["string", "null"],
      "enum": ["client", "worker", null],
      "description": "Caller's party role, null for a deal manager who is not a party."
    },
    "termsHashNow": {
      "type": "string"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payoutScope": {
      "type": "string",
      "enum": ["all", "own"],
      "description": "all: the brand, or a deal manager not on the crew, sees every member's payout lines. own: a crew member (payee) sees only their own payouts; other members' lines and payout batches are left out and paidOutMinor is their own total."
    }
  },
  "definitions": {
    "DealMilestoneState": {
      "title": "DealMilestoneState",
      "type": "string",
      "enum": [
        "DRAFT",
        "SIGNED",
        "FUNDED",
        "STYLE_SAMPLE",
        "SUBMITTED",
        "CHECKS",
        "IN_REVIEW",
        "CHANGES_REQUESTED",
        "APPROVED",
        "AUTO_APPROVED",
        "CAPTURED",
        "PAID_OUT",
        "KILLED",
        "CANCELLED",
        "DISPUTED"
      ]
    },
    "DealRole": {
      "title": "DealRole",
      "type": "string",
      "enum": ["client", "worker"]
    },
    "DealParty": {
      "title": "DealParty",
      "type": "object",
      "required": ["role", "userId", "displayName"],
      "properties": {
        "role": {
          "$ref": "#/definitions/DealRole"
        },
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "paypalEmail": {
          "type": "string"
        }
      }
    },
    "DealMeasure": {
      "title": "DealMeasure",
      "type": "object",
      "required": ["metric", "op"],
      "properties": {
        "metric": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": ["<=", ">=", "==", "between", "present", "absent"]
        },
        "value": {
          "type": ["number", "string"]
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "window": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "DealChecklistItem": {
      "title": "DealChecklistItem",
      "type": "object",
      "required": ["id", "text", "kind"],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["check", "taste"],
          "description": "check = machine-verifiable; taste = people decide (never blocks pay on its own)"
        },
        "measure": {
          "$ref": "#/definitions/DealMeasure"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "DealPayee": {
      "title": "DealPayee",
      "type": "object",
      "required": ["userId", "email", "shareBp"],
      "properties": {
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "shareBp": {
          "type": "integer"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "DealMilestoneTerms": {
      "title": "DealMilestoneTerms",
      "type": "object",
      "required": [
        "key",
        "title",
        "amountMinor",
        "dueAt",
        "graceHours",
        "reviewWindowHours",
        "revisionRoundsIncluded",
        "styleSample",
        "checklist",
        "payees"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "amountMinor": {
          "type": "integer"
        },
        "dueAt": {
          "type": "string"
        },
        "graceHours": {
          "type": "number"
        },
        "reviewWindowHours": {
          "type": "number"
        },
        "revisionRoundsIncluded": {
          "type": "integer"
        },
        "styleSample": {
          "type": "boolean"
        },
        "checklist": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealChecklistItem"
          }
        },
        "payees": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealPayee"
          }
        }
      }
    },
    "DealRateCardItem": {
      "title": "DealRateCardItem",
      "type": "object",
      "required": ["id", "label", "unit", "unitPriceMinor"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "unitPriceMinor": {
          "type": "integer"
        }
      }
    },
    "DealTerms": {
      "title": "DealTerms",
      "type": "object",
      "required": [
        "title",
        "currency",
        "client",
        "worker",
        "milestones",
        "rateCard",
        "killFeeBp",
        "humanApprovalThresholdMinor"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "client": {
          "$ref": "#/definitions/DealParty"
        },
        "worker": {
          "$ref": "#/definitions/DealParty"
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealMilestoneTerms"
          }
        },
        "rateCard": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealRateCardItem"
          }
        },
        "killFeeBp": {
          "type": "integer"
        },
        "humanApprovalThresholdMinor": {
          "type": "integer"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "styleChoices": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "DealSignature": {
      "title": "DealSignature",
      "type": "object",
      "required": ["party", "userId", "termsHash", "at"],
      "properties": {
        "party": {
          "$ref": "#/definitions/DealRole"
        },
        "userId": {
          "type": "string"
        },
        "termsHash": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "DealReauthorization": {
      "title": "DealReauthorization",
      "type": "object",
      "required": ["authorizationId", "at"],
      "properties": {
        "authorizationId": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "DealFunding": {
      "title": "DealFunding",
      "type": "object",
      "required": ["status"],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "approveUrl": {
          "type": "string"
        },
        "authorizationId": {
          "type": "string"
        },
        "authorizedMinor": {
          "type": "integer"
        },
        "authorizedAt": {
          "type": "string"
        },
        "honorExpiresAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "reauthorizations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealReauthorization"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "APPROVED",
            "AUTHORIZED",
            "PARTIALLY_CAPTURED",
            "CAPTURED",
            "VOIDED",
            "EXPIRED"
          ]
        }
      }
    },
    "DealCheckEvidence": {
      "title": "DealCheckEvidence",
      "type": "object",
      "required": ["tStart", "tEnd", "note"],
      "properties": {
        "tStart": {
          "type": "number"
        },
        "tEnd": {
          "type": "number"
        },
        "note": {
          "type": "string"
        },
        "screenshot": {
          "type": "string"
        }
      }
    },
    "DealCheckResult": {
      "title": "DealCheckResult",
      "type": "object",
      "required": ["checklistId", "metric", "measured", "passed", "status", "evidence"],
      "properties": {
        "checklistId": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "measured": {
          "type": ["number", "string", "boolean", "null"]
        },
        "passed": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["ok", "not_measurable"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealCheckEvidence"
          }
        }
      }
    },
    "DealVersionChecks": {
      "title": "DealVersionChecks",
      "type": "object",
      "required": ["reportId", "passed", "failed", "at"],
      "properties": {
        "reportId": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealCheckResult"
          }
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "DealVersion": {
      "title": "DealVersion",
      "type": "object",
      "required": ["id", "sha256", "submittedAt"],
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "submittedAt": {
          "type": "string"
        },
        "checks": {
          "$ref": "#/definitions/DealVersionChecks"
        }
      }
    },
    "DealChangeOrder": {
      "title": "DealChangeOrder",
      "type": "object",
      "required": [
        "id",
        "milestoneKey",
        "rateCardItemId",
        "quantity",
        "amountMinor",
        "reason",
        "status",
        "at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "milestoneKey": {
          "type": "string"
        },
        "rateCardItemId": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "amountMinor": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "invoiced", "accepted", "declined"]
        },
        "invoiceId": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "enum": ["agent", "client", "worker"]
        },
        "decidedAt": {
          "type": "string"
        },
        "decidedBy": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "description": "Priced from the signed rate card; the client accepts with one tap."
    },
    "DealCapture": {
      "title": "DealCapture",
      "type": "object",
      "required": ["id", "amountMinor", "reason", "at"],
      "properties": {
        "id": {
          "type": "string"
        },
        "amountMinor": {
          "type": "integer"
        },
        "versionId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "DealPayout": {
      "title": "DealPayout",
      "type": "object",
      "required": ["batchId", "amountMinor", "email", "at", "status"],
      "properties": {
        "batchId": {
          "type": "string"
        },
        "amountMinor": {
          "type": "integer"
        },
        "email": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "DealChangeItem": {
      "title": "DealChangeItem",
      "type": "object",
      "required": ["text", "tag"],
      "properties": {
        "text": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "enum": ["fix", "taste"]
        },
        "checklistId": {
          "type": "string"
        },
        "disputed": {
          "type": "boolean"
        }
      }
    },
    "DealChangeRequest": {
      "title": "DealChangeRequest",
      "type": "object",
      "required": ["at", "items", "tasteRound"],
      "properties": {
        "at": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealChangeItem"
          }
        },
        "tasteRound": {
          "type": "boolean"
        },
        "changeOrderId": {
          "type": "string"
        }
      }
    },
    "DealPolicyViolation": {
      "title": "DealPolicyViolation",
      "type": "object",
      "required": ["rule", "message"],
      "properties": {
        "rule": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "DealStoredDecision": {
      "title": "DealStoredDecision",
      "type": "object",
      "required": ["allowed", "violations"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealPolicyViolation"
          }
        },
        "needsHumanApproval": {
          "type": "boolean"
        },
        "assumed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DealContradiction": {
      "title": "DealContradiction",
      "type": "object",
      "required": ["a", "b", "why"],
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "DealReviewProposal": {
      "title": "DealReviewProposal",
      "type": "object",
      "required": [
        "id",
        "agent",
        "at",
        "versionId",
        "items",
        "downgraded",
        "contradictions",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "enum": ["review"]
        },
        "at": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealChangeItem"
          }
        },
        "downgraded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealContradiction"
          }
        },
        "costsRevisionRound": {
          "type": "boolean"
        },
        "roundsLeftAfter": {
          "type": "integer"
        },
        "rationale": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/definitions/DealStoredDecision"
        }
      }
    },
    "DealDisputeBasis": {
      "title": "DealDisputeBasis",
      "type": "object",
      "required": ["passedChecks", "totalChecks", "shareBp", "amountMinor", "remainingMinor"],
      "properties": {
        "passedChecks": {
          "type": "integer"
        },
        "totalChecks": {
          "type": "integer"
        },
        "shareBp": {
          "type": "integer"
        },
        "amountMinor": {
          "type": "integer"
        },
        "remainingMinor": {
          "type": "integer"
        }
      }
    },
    "DealDisputeCheck": {
      "title": "DealDisputeCheck",
      "type": "object",
      "required": ["id", "text", "passed", "evidence"],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "passed": {
          "type": ["boolean", "null"]
        },
        "measured": {
          "type": ["number", "string", "boolean", "null"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealCheckEvidence"
          }
        }
      }
    },
    "DealRounds": {
      "title": "DealRounds",
      "type": "object",
      "required": ["included", "used", "tasteRounds"],
      "properties": {
        "included": {
          "type": "integer"
        },
        "used": {
          "type": "integer"
        },
        "tasteRounds": {
          "type": "integer"
        }
      }
    },
    "DealDisputeEvidence": {
      "title": "DealDisputeEvidence",
      "type": "object",
      "required": ["checks", "unmeasured", "tasteLines", "rounds", "changeRequests", "versions"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealDisputeCheck"
          }
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasteLines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounds": {
          "$ref": "#/definitions/DealRounds"
        },
        "changeRequests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealChangeRequest"
          }
        },
        "versions": {
          "type": "integer"
        }
      }
    },
    "DealDisputeProposal": {
      "title": "DealDisputeProposal",
      "type": "object",
      "required": [
        "id",
        "agent",
        "at",
        "basis",
        "workerMinor",
        "clientMinor",
        "evidence",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "enum": ["scope_dispute"]
        },
        "at": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "basis": {
          "$ref": "#/definitions/DealDisputeBasis"
        },
        "workerMinor": {
          "type": "integer",
          "description": "Computed in Node from checklist arithmetic, never by an AI."
        },
        "clientMinor": {
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/definitions/DealDisputeEvidence"
        },
        "notes": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/definitions/DealStoredDecision"
        }
      }
    },
    "DealProposals": {
      "title": "DealProposals",
      "type": "object",
      "required": [],
      "properties": {
        "review": {
          "$ref": "#/definitions/DealReviewProposal"
        },
        "dispute": {
          "$ref": "#/definitions/DealDisputeProposal"
        }
      }
    },
    "DealSplit": {
      "title": "DealSplit",
      "type": "object",
      "required": [],
      "properties": {
        "client": {
          "type": "integer"
        },
        "worker": {
          "type": "integer"
        }
      },
      "description": "Dispute split each side accepted, in minor units owed to the worker."
    },
    "DealHistoryEntry": {
      "title": "DealHistoryEntry",
      "type": "object",
      "required": ["at", "from", "to", "event", "actor"],
      "properties": {
        "at": {
          "type": "string"
        },
        "from": {
          "$ref": "#/definitions/DealMilestoneState"
        },
        "to": {
          "$ref": "#/definitions/DealMilestoneState"
        },
        "event": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "enum": ["client", "worker", "system", "reviewer"]
        }
      }
    },
    "DealMilestoneRuntime": {
      "title": "DealMilestoneRuntime",
      "type": "object",
      "required": [
        "key",
        "state",
        "styleApproved",
        "versions",
        "revisionRoundsUsed",
        "tasteRoundsUsed",
        "capturedMinor",
        "captures",
        "paidOutMinor",
        "payouts",
        "changeRequests",
        "history"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/DealMilestoneState"
        },
        "styleApproved": {
          "type": "boolean"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealVersion"
          }
        },
        "approvedVersionId": {
          "type": "string"
        },
        "revisionRoundsUsed": {
          "type": "integer"
        },
        "tasteRoundsUsed": {
          "type": "integer"
        },
        "reviewStartedAt": {
          "type": "string"
        },
        "funding": {
          "$ref": "#/definitions/DealFunding"
        },
        "capturedMinor": {
          "type": "integer"
        },
        "captures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealCapture"
          }
        },
        "paidOutMinor": {
          "type": "integer"
        },
        "payouts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealPayout"
          }
        },
        "changeRequests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealChangeRequest"
          }
        },
        "split": {
          "$ref": "#/definitions/DealSplit"
        },
        "firstSubmittedAt": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string"
        },
        "proposals": {
          "$ref": "#/definitions/DealProposals"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealHistoryEntry"
          }
        }
      }
    },
    "DealPendingApproval": {
      "title": "DealPendingApproval",
      "type": "object",
      "required": ["key", "action", "at", "reason"],
      "properties": {
        "key": {
          "type": "string"
        },
        "action": {
          "type": "object",
          "description": "The money action waiting for one human tap (amounts come from the deal)."
        },
        "at": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "DealAlert": {
      "title": "DealAlert",
      "type": "object",
      "required": ["at", "milestoneKey", "eventType", "message"],
      "properties": {
        "at": {
          "type": "string"
        },
        "milestoneKey": {
          "type": "string"
        },
        "eventType": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "DealLedgerType": {
      "title": "DealLedgerType",
      "type": "string",
      "enum": [
        "authorize",
        "reauthorize",
        "capture",
        "partial_capture",
        "void",
        "refund",
        "payout",
        "invoice",
        "blocked",
        "pending_approval",
        "webhook",
        "state"
      ]
    },
    "DealLedgerPolicy": {
      "title": "DealLedgerPolicy",
      "type": "object",
      "required": ["allowed", "violations"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealPolicyViolation"
          }
        }
      }
    },
    "DealLedgerEntry": {
      "title": "DealLedgerEntry",
      "type": "object",
      "required": [
        "dealId",
        "orgId",
        "milestoneKey",
        "seq",
        "type",
        "amountMinor",
        "currency",
        "moved",
        "actor",
        "explanation",
        "at",
        "prevHash",
        "hash"
      ],
      "properties": {
        "dealId": {
          "type": "string"
        },
        "orgId": {
          "type": "string"
        },
        "milestoneKey": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "type": {
          "$ref": "#/definitions/DealLedgerType"
        },
        "amountMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "moved": {
          "type": "boolean"
        },
        "paypalRef": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/definitions/DealLedgerPolicy"
        },
        "at": {
          "type": "string"
        },
        "prevHash": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "description": "One hash-chained money ledger line. blocked / pending_approval / state lines move no money."
    },
    "DealChain": {
      "title": "DealChain",
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "brokenAt": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "DealLedgerTotals": {
      "title": "DealLedgerTotals",
      "type": "object",
      "required": [
        "heldMinor",
        "capturedMinor",
        "refundedMinor",
        "paidOutMinor",
        "invoicedMinor",
        "blockedCount"
      ],
      "properties": {
        "heldMinor": {
          "type": "integer"
        },
        "capturedMinor": {
          "type": "integer"
        },
        "refundedMinor": {
          "type": "integer"
        },
        "paidOutMinor": {
          "type": "integer"
        },
        "invoicedMinor": {
          "type": "integer"
        },
        "blockedCount": {
          "type": "integer"
        }
      }
    },
    "DealLedgerView": {
      "title": "DealLedgerView",
      "type": "object",
      "required": ["entries", "chain", "totals"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DealLedgerEntry"
          }
        },
        "chain": {
          "$ref": "#/definitions/DealChain"
        },
        "totals": {
          "$ref": "#/definitions/DealLedgerTotals"
        },
        "scope": {
          "type": "string",
          "enum": ["all", "own"],
          "description": "own: a crew member's ledger, with only their own payout lines (no other member's, no batch-level payout lines); totals are recomputed from those entries. The chain is verified on the full ledger."
        }
      },
      "description": "GET /organizations/:org/deals/:dealId/ledger"
    },
    "DealLedgerPush": {
      "title": "DealLedgerPush",
      "type": "object",
      "required": ["dealId", "entry"],
      "properties": {
        "dealId": {
          "type": "string"
        },
        "entry": {
          "$ref": "#/definitions/DealLedgerEntry"
        }
      },
      "description": "Socket.IO deal:ledger payload (room deal:<id>)."
    }
  }
}
