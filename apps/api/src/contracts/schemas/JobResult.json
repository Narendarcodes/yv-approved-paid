{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "JobResult.json",
  "title": "JobResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "type",
    "status"
  ],
  "properties": {
    "jobId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "dead_lettered"
      ]
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "attempts": {
      "type": "integer"
    }
  }
}
