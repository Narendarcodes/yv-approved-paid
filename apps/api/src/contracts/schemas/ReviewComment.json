{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ReviewComment.json",
  "title": "ReviewComment",
  "type": "object",
  "required": [
    "id",
    "postId",
    "author",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "postId": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "timecodeSec": {
      "type": "number"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
