# Lean deal agent (app/deals_service.py; Dockerfile.deals; Render free web service).
# Secrets: AGENT_SHARED_SECRET, RIVER_API_KEY, NVIDIA_API_KEY. Never commit real values.
AGENT_SHARED_SECRET=            # >= 32 chars; same value as on the API service (X-Agent-Secret)
RIVER_API_KEY=                  # River AI, https://api.river.ai/v1
NVIDIA_API_KEY=                 # NVIDIA NIM, https://integrate.api.nvidia.com/v1
LLM_CHAIN=river,nim             # order of providers; add omniroute only with OMNIROUTE_URL
RIVER_MODEL=Qwen/Qwen3.8-27B-FP8
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_S=12                # per provider call
LLM_CALLER=httpx                # httpx (lean image) | litellm (full image)
# LLM_CACHE_DIR=/tmp/llm_cache  # replies cached by (purpose, prompt); /tmp on Render
# LLM_OFFLINE=1                 # cache-only (tests/CI)
