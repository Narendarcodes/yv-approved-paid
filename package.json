{
  "name": "yv-monorepo",
  "private": true,
  "description": "yv. content ops: apps/web (React), apps/api (Node, system of record), services/agent (Python agent + worker), contracts, infra",
  "scripts": {
    "api:test": "npm --prefix apps/api test",
    "api:dev": "npm --prefix apps/api run dev",
    "web:dev": "npm --prefix apps/web run dev",
    "agent:test": "cd services/agent && python -m pytest -q",
    "contracts:gen": "cd contracts && ./gen.sh",
    "contracts:check": "npm --prefix contracts run check",
    "seed:agent": "node apps/api/scripts/seed-agent-demo.js",
    "seed:deals": "node apps/api/scripts/seed-deal-demo.cjs",
    "stack:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build",
    "e2e": "python3 infra/e2e.py --api http://127.0.0.1:3000/api/v1 --seed seed.json",
    "lint:boundaries": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "prepare": "husky || true",
    "typecheck": "npm --prefix apps/web run -s typecheck && npm --prefix apps/api run -s typecheck",
    "lint-staged": "lint-staged --concurrent false"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10"
  }
}
