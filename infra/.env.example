COMPOSE_PROJECT_NAME=yv
# Every secret below: >= 32 random chars (openssl rand -hex 32); the api refuses
# to start in production with a weak or default value (apps/api/src/config/validate.js).
JWT_ACCESS_SECRET=
# Same value on the API and on the lean deal agent (yv-deals-agent verifies Brand Brain chat tokens with it)
SERVICE_JWT_SECRET=
# Signs CSRF tokens for cookie sessions (ADR-0017)
CSRF_SECRET=
# Shared token for the private /internal listener (api-internal:3001, never published)
INTERNAL_API_TOKEN=
# Allowed browser origins (comma-separated); required in production
CORS_ORIGIN=http://localhost:5173
# LiteLLM model id. stub = deterministic offline writer. Examples:
#   LLM_MODEL=openai/llm  LLM_API_BASE=http://127.0.0.1:8001/v1   (any OpenAI-compatible vLLM)
#   LLM_MODEL=gpt-4o-mini LLM_API_KEY=sk-...
#   LLM_MODEL=chain  (deal copilot chain: LLM_CHAIN=river,nim, RIVER_*/NIM_* vars; River 402 falls through to NIM)
LLM_MODEL=stub
# Brand Brain timeouts (agent): no text within LLM_FIRST_TOKEN_S -> next provider; none by LLM_DEADLINE_S ->
# the answer lists the matching brand entries; LLM_STALL_S of silence mid-answer ends the answer.
# LLM_FIRST_TOKEN_S=12
# LLM_DEADLINE_S=22
# LLM_STALL_S=10
# API: AGENT_CHAT_FIRST_BYTE_MS=30000 (no SSE headers from the agent -> 504 "waking up")
LLM_API_BASE=
LLM_API_KEY=
# Whisper STT endpoint (POST {language, audio_b64, engine}); empty = fixture transcripts
STT_URL=
