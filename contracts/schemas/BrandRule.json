{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "BrandRule.json",
  "title": "BrandRule",
  "type": "object",
  "required": [
    "id",
    "title",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "voice",
        "visual",
        "do",
        "dont",
        "audience",
        "resource",
        "purpose"
      ]
    },
    "sourceUrl": {
      "type": "string"
    }
  }
}
