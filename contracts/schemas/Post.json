{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Post.json",
  "title": "Post",
  "type": "object",
  "required": [
    "id",
    "orgId",
    "platform",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "youtube",
        "instagram",
        "x",
        "linkedin"
      ]
    },
    "externalId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "durationSec": {
      "type": "number"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "postiz",
        "youtube_analytics",
        "instagram_graph",
        "fixture",
        "manual"
      ]
    }
  }
}
