{
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "options": {
        "semi": false
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
